# API base — Vite dev server proxies /api → http://127.0.0.1:8000/api/v1
VITE_API_BASE_URL=/api

# Default store ID (used when storeId is not yet in session storage)
VITE_DEFAULT_STORE_ID=1

# --- Mock flags (set to 'true' only for offline / demo mode) ---
VITE_USE_MOCK_PRODUCTS=false
VITE_USE_MOCK_AUTH=false
VITE_USE_MOCK_SUPPLIERS=false
VITE_USE_MOCK_TRANSACTIONS=false
VITE_USE_MOCK_ORDERS=false
