# App
APP_NAME="Enterprise Retail & Strategic Inventory System"
APP_VERSION=1.0.0
DEBUG=true

# Database
# Example: mysql+pymysql://user:password@localhost/dbname
DATABASE_URL=mysql+pymysql://root:password@localhost/ersis

# JWT
JWT_SECRET_KEY=ersis-dev-secret-key-change-in-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# OTP / 2FA
OTP_EXPIRE_MINUTES=5
OTP_LENGTH=6

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=your-email@gmail.com

# MQTT (IoT)
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_SCAN_TOPIC=ersis/scans

# AI / RAG
EMBEDDING_MODEL=all-MiniLM-L6-v2
LLM_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key
FAISS_INDEX_DIR=faiss_indexes
