# =============================================================
# ERSIS – Environment Variables for Docker Compose
#
# PLACE THIS FILE AT THE PROJECT ROOT (next to docker-compose.yml)
# Copy this to .env and fill in your real values:
#   cp .env.docker.example .env
#
# docker-compose.yml reads this root .env automatically for
# variable substitution (${...} syntax in the compose file).
# =============================================================

# ── MySQL ──────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=StrongP@ssw0rd!
MYSQL_DATABASE=ersis

# ── These mirror backend/.env but use Docker service names ──
# The backend container's DATABASE_URL is overridden in
# docker-compose.yml to point to "db" (the MySQL service name).
# You do NOT need to change DATABASE_URL here; it is set
# automatically in docker-compose.yml using the vars above.

# ── JWT (change this to a long random string in production) ─
JWT_SECRET_KEY=change-me-to-a-very-long-random-secret

# ── Groq AI API Key ─────────────────────────────────────────
GROQ_API_KEY=your-groq-api-key-here

# ── SMTP (for OTP emails) ───────────────────────────────────
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
EMAIL_FROM=your-email@gmail.com
